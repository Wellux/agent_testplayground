# Local config (never commit the user's actual vault path / secrets)
prompts/ralph-meta-chain/config.yml
*.local.yml
*.local.yaml

# Secrets
.env
.env.*
!.env.example
**/secrets.local
**/secrets.local.*

# Obsidian plugin build artifacts
obsidian-ralph/main.js
obsidian-ralph/node_modules/
obsidian-ralph/.npm/
obsidian-ralph/dist/

# Harness build/run artifacts
harness/.venv/
harness/__pycache__/
harness/**/__pycache__/
harness/.pytest_cache/
harness/.uv/
harness/dist/
harness/*.egg-info/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Vault sidecars (in case vault is ever symlinked into repo)
*.db
*.db-journal
*.db-wal
*.db-shm

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Migration script outputs — regenerated by migration/scripts/* on each run.
# README.md and migration-plan.md are tracked; the rest are generated.
prompts/ralph-meta-chain/migration/inventory-report.md
prompts/ralph-meta-chain/migration/file-classification.md
prompts/ralph-meta-chain/migration/proposed-moves.md
prompts/ralph-meta-chain/migration/rollback-plan.md
prompts/ralph-meta-chain/migration/conflicts.md
prompts/ralph-meta-chain/migration/migration-log.md
prompts/ralph-meta-chain/migration/ci-backup-*.yml
prompts/ralph-meta-chain/migration/snapshot-*.txt
