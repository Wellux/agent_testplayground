# Copy to harness/.env and fill in. .env is gitignored.

# Required for `harness ab` and `harness compress` (judge + summarize calls).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the local Ollama base URL used for embeddings.
# Default is http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: override the embedding model. Default is nomic-embed-text.
# Pull it once with: ollama pull nomic-embed-text
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: override the vault path used by harness commands. Defaults to
# config.yml's vault_path or the $VAULT environment variable.
# VAULT=/Users/me/Obsidian/SecondBrain
