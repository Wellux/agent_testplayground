<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for Ralph meta-chain launchd agents on macOS.

  Placeholders (substituted by scripts/install.sh):
    @@AXIS@@        research | memory | skills | interaction | compress | heal | evolve | update
    @@HOUR@@        0..23, or -1 for hourly, or -6 for every-6-hours
    @@MINUTE@@      0..59
    @@PROMPT@@      file under $RALPH/ to feed claude -p
    @@TIMEOUT_BIN@@ absolute path to GNU `timeout` (Linux: /usr/bin/timeout;
                    macOS w/ Homebrew coreutils: /opt/homebrew/bin/gtimeout
                    or /usr/local/bin/gtimeout). install.sh probes at install
                    time and refuses if neither is available, so launchd
                    never gets a plist whose ProgramArguments is broken.
    @@TIMEOUT@@     seconds for the outer wrapper
    @@MAXITERS@@    inner Ralph max iterations
    @@WEEKDAY@@     0..6 (0=Sun) for weekly axes; empty for daily/hourly
    @@RALPH@@       absolute path to prompts/ralph-meta-chain
    @@LOG@@         absolute path to log file

  Note: this template renders a single calendar trigger. install.sh post-
  processes the rendered plist to (a) drop the <key>Hour</key>+<integer/>
  pair when @@HOUR@@ is -1 (hourly) or -6 (every 6h), and (b) inject
  <key>Weekday</key><integer>N</integer> when @@WEEKDAY@@ is non-empty.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.ralph.@@AXIS@@</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>i=0; while [ $((i+=1)) -le @@MAXITERS@@ ]; do o=$(@@TIMEOUT_BIN@@ @@TIMEOUT@@ claude -p "$(cat @@RALPH@@/@@PROMPT@@)" 2>&1); rc=$?; printf '%s\n' "$o"; case "$o" in *"&lt;promise&gt;COMPLETE&lt;/promise&gt;"*) break;; esac; [ $rc -ne 0 ] &amp;&amp; break; done</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>@@HOUR@@</integer>
    <key>Minute</key>
    <integer>@@MINUTE@@</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>@@LOG@@</string>
  <key>StandardErrorPath</key>
  <string>@@LOG@@</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
