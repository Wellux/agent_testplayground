{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Wellux/agent_testplayground/raw/main/prompts/ralph-meta-chain/config/experiment.schema.json",
  "title": "Ralph metrics.ndjson row",
  "description": "Schema for one row of $VAULT/90-Meta/metrics.ndjson. Every row is one experiment / A/B arm / heal-check / compress.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/ab_row" },
    { "$ref": "#/definitions/research_row" },
    { "$ref": "#/definitions/compress_row" },
    { "$ref": "#/definitions/heal_row" },
    { "$ref": "#/definitions/skill_row" }
  ],
  "definitions": {
    "ab_row": {
      "type": "object",
      "required": ["axis", "fixture", "started", "arm"],
      "properties": {
        "axis":            { "type": "string", "const": "interaction" },
        "fixture":         { "type": "string" },
        "started":         { "type": "string", "format": "date-time" },
        "incumbent_path":  { "type": "string" },
        "candidate_path":  { "type": "string" },
        "model":           { "type": "string" },
        "judge_model":     { "type": "string" },
        "arm":             { "type": "string", "enum": ["incumbent", "candidate"] },
        "tokens":          { "type": "integer", "minimum": 0 },
        "rubric":          { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "banned":          { "type": "integer", "minimum": 0 },
        "latency":         { "type": "number", "minimum": 0.0 },
        "verdict":         { "type": "string" },
        "provider":        { "type": "string" },
        "provider_version":{ "type": "string" }
      }
    },
    "research_row": {
      "type": "object",
      "required": ["axis", "started"],
      "properties": {
        "axis":      { "type": "string", "const": "research" },
        "started":   { "type": "string", "format": "date-time" },
        "topics":    { "type": "array", "items": { "type": "string" } },
        "repos":     { "type": "integer" },
        "deduped":   { "type": "integer" }
      }
    },
    "compress_row": {
      "type": "object",
      "required": ["axis", "action"],
      "properties": {
        "axis":          { "type": "string", "const": "compress" },
        "action":        { "type": "string", "enum": ["atomic", "weekly"] },
        "note":          { "type": "string" },
        "week":          { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "tokens_before": { "type": "integer" },
        "tokens_after":  { "type": "integer" },
        "ratio":         { "type": "number" },
        "days":          { "type": "integer" }
      }
    },
    "heal_row": {
      "type": "object",
      "required": ["name", "started", "ok"],
      "properties": {
        "name":       { "type": "string", "enum": ["privacy", "shell", "python", "unit-tests", "plugin"] },
        "started":    { "type": "string", "format": "date-time" },
        "duration_s": { "type": "number" },
        "rc":         { "type": "integer" },
        "ok":         { "type": "boolean" },
        "detail":     { "type": "string" }
      }
    },
    "skill_row": {
      "type": "object",
      "required": ["axis", "skill", "started"],
      "properties": {
        "axis":       { "type": "string", "const": "skills" },
        "skill":      { "type": "string" },
        "started":    { "type": "string", "format": "date-time" },
        "duration_s": { "type": "number" },
        "metric":     { "type": "string" },
        "value":      { "type": "number" },
        "mean_tokens":{ "type": "integer" },
        "verdict":    { "type": "string", "enum": ["validated", "refuted", "inconclusive"] }
      }
    }
  }
}
